<% layout("/layouts/boilerplate") %>
<div class="page-wrap page">
    <div class="mx-auto" style="max-width: 760px;">
        <div class="page-head">
            <div>
                <h1 style="font-size: clamp(1.8rem, 3.4vw, 2.5rem);">Edit your listing</h1>
                <p><%= listing.title %></p>
            </div>
        </div>
        <%- include("_form.ejs", {
            action: `/listings/${listing._id}?_method=PUT`,
            submitLabel: "Save changes",
            loadingLabel: "Saving…",
            cancelHref: `/listings/${listing._id}`,
            categories,
            listing,
            formValues: formValues
        }) %>
    </div>
</div>
