<% layout("/layouts/boilerplate") %>
<% const fv = formValues || {}; %>
<div class="page-wrap page">
    <div class="auth-wrap form-card">
        <h1>Create your account</h1>
        <p class="lead-sm">Join Velora to list properties and share reviews.</p>
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" type="text" class="form-control" value="<%= fv.username || '' %>" autocomplete="username" required autofocus>
                <div class="invalid-feedback">Choose a username.</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control" value="<%= fv.email || '' %>" autocomplete="email" required>
                <div class="invalid-feedback">Enter a valid email address.</div>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" type="password" class="form-control" autocomplete="new-password" required>
                <div class="invalid-feedback">Choose a password.</div>
            </div>
            <button class="btn btn-vel btn-lg w-100" type="submit" data-loading="Creating account…">Sign up</button>
        </form>
        <p class="auth-foot">Already have an account? <a href="/login">Log in</a></p>
    </div>
</div>
