<% const flashOk = success || []; const flashBad = error || []; %>
<% if (flashOk.length || flashBad.length) { %>
<div class="page-wrap flash-stack" aria-live="polite">
    <% for (const msg of flashOk) { %>
    <div class="alert alert-success alert-dismissible fade show" role="status" data-autodismiss>
        <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>
    <% for (const msg of flashBad) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i><%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>
</div>
<% } %>
