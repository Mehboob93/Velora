<% const navPath = locals.currentPath || ""; const navType = locals.currentType || ""; const navIsHome = !!locals.isHome; %>
<header class="site-header">
  <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
    <div class="page-wrap d-flex flex-wrap align-items-center">
      <a class="brand" href="/" aria-label="Velora home">
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#0f4c45"/><path d="M7 15.5 16 8l9 7.5" fill="none" stroke="#f2a93b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 14v9h12v-9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linejoin="round"/></svg>
        Velora
      </a>
      <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-lg-3 me-auto gap-lg-1">
          <li class="nav-item"><a class="nav-link <%= navPath === '/listings' && navType === 'sale' ? 'active' : '' %>" href="/listings?type=sale">Buy</a></li>
          <li class="nav-item"><a class="nav-link <%= navPath === '/listings' && navType === 'rent' ? 'active' : '' %>" href="/listings?type=rent">Rent</a></li>
          <li class="nav-item"><a class="nav-link <%= navPath === '/listings' && !navType ? 'active' : '' %>" href="/listings">Browse all</a></li>
        </ul>

        <% if (!navIsHome) { %>
        <form class="nav-search me-lg-3" action="/listings" method="get" role="search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <label class="visually-hidden" for="nav-q">Search properties</label>
          <input id="nav-q" class="form-control" type="search" name="q" placeholder="Search city, area or keyword" maxlength="100">
        </form>
        <% } %>

        <div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2 mt-2 mt-lg-0">
          <a class="btn btn-accent" href="/listings/new"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>List your property</a>
          <% if (!currUser) { %>
            <a class="btn btn-ghost" href="/login">Log in</a>
            <a class="btn btn-vel" href="/signup">Sign up</a>
          <% } else { %>
            <div class="dropdown">
              <button class="btn btn-ghost user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar" aria-hidden="true"><%= currUser.username.charAt(0).toUpperCase() %></span>
                <span><%= currUser.username %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/listings/new">List a property</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout">Log out</a></li>
              </ul>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
